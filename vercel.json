{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/landoversea run build",
  "outputDirectory": "artifacts/landoversea/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://land-over-sea-international.replit.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
