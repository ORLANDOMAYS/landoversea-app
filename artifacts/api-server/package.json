{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development AUTH_RECOVERY_TEST_MODE=1 && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:registration": "tsx --test test/registration.integration.test.mjs",
    "test:delete-account": "node --test test/delete-account.integration.test.mjs",
    "test:email-verification": "tsx --test test/email-verification.integration.test.mjs",
    "test:coaching-culture-safety": "tsx --test test/coaching-culture-safety.integration.test.mjs",
    "test:messaging": "node --test test/messaging-matching.integration.test.mjs",
    "test:discover-filters": "tsx --test test/discover-filters.integration.test.mjs",
    "test:admin-migrations": "tsx --test test/admin-migrations.integration.test.mjs",
    "test:verification": "node --test test/verification.integration.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:api": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.15.1",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
