{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "landover-sea.com",
        "EXPO_PUBLIC_RELEASE": "1"
      }
    }
  }
}